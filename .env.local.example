# Local development — copy to .env and fill in values
DATABASE_URL=postgresql://pgadmin:localpass@localhost:5432/socket_server

# Obligatorio — genera uno con: openssl rand -hex 32
SESSION_SECRET=

# Azure Storage for db snapshots and uploads (get from: az storage account show-connection-string --name saapivio --resource-group rg-vio-shared -o tsv)
AZURE_STORAGE_CONNECTION_STRING=

# Puerto del server (default: 5000) — en macOS usa 5001, el 5000 lo ocupa AirPlay Receiver
# PORT=5001

# Optional: your name shown in snapshot filenames (defaults to git user.name)
# DB_SNAPSHOT_AUTHOR=angelo

# Klarna Payments — Express Checkout order creation (server-side, secret).
# From the Klarna Merchant Portal → Settings → API credentials (playground
# vs production are separate). Base URL switches sandbox↔live.
KLARNA_API_BASE=https://api.playground.klarna.com
KLARNA_API_USERNAME=
KLARNA_API_PASSWORD=
